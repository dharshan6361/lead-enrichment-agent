# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional bonus feature: fills in LinkedIn URLs for leadership members not
# found directly on the company site. Get a free key (1,000 searches/month,
# no card required) at https://tavily.com. If left blank, this feature is
# skipped automatically and the rest of the pipeline is unaffected.
TAVILY_API_KEY=
